#!/bin/sh
# The AppImage's entry point: the tray app, with its icon and the GTK themes
# for Chrome's window frame.
HERE=$(dirname "$(readlink -f "$0")")
export CHATTER_ICON="${CHATTER_ICON:-$HERE/chatter.png}"
export CHATTER_GTK_THEMES="${CHATTER_GTK_THEMES:-$HERE/usr/share}"
exec "$HERE/usr/lib/chatter/chatter" "$@"
